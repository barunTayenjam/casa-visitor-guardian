  "cards": [
    {
      "dot": "cyan",
      "title": "Video Path",
      "items": [
        "Python reads rtsp://go2rtc:8554/cam{n}_low over ffmpeg/TCP — never the camera directly",
        "MOG2 motion gate → in-process YOLO ONNX → ByteTracker → face/pose identity"
      ]
    },
    {
      "dot": "violet",
      "title": "AI Analysis (on-demand)",
      "items": [
        "POST /api/nvidia/analyze* → base64 evidence to OpenAI-compatible /chat/completions (circuit breaker + retries)",
        "Results upserted into ai_analysis_results and events metadata"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "socket.io rooms camera-{id}-live / -detect relay frames; events trigger web-push (VAPID)",
        "Browser plays WebRTC → MSE → HLS via the /go2rtc proxy, MJPEG fallback"
      ]
    }
  ]
